{
  "buildCommand": "npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/internal/cron/sync-agency-hierarchy", "schedule": "0 18 * * *" },
    { "path": "/api/internal/cron/expire-bank-transfer-orders", "schedule": "0 19 * * *" },
    { "path": "/api/internal/cron/process-nft-mints", "schedule": "0 20 * * *" },
    { "path": "/api/internal/cron/process-integration-outbox", "schedule": "*/5 * * * *" },
    { "path": "/api/internal/cron/process-notification-outbox", "schedule": "0 22 * * *" },
    { "path": "/api/internal/cron/process-order-linking-jobs", "schedule": "0 23 * * *" },
    { "path": "/api/internal/cron/cleanup-rate-limit-buckets", "schedule": "30 17 * * *" },
    { "path": "/api/internal/cron/cleanup-wallet-claim-nonces", "schedule": "0 16 * * *" }
  ]
}

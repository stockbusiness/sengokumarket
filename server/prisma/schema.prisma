generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 仕様書v1.5 6章のテーブル定義に対応。
// status系カラムはTEXTで、有効値はコメントに記載する(コード側で管理)。

// 仕様書外の拡張: Stripe/Resend等の連携設定を管理画面から変更できるようにするための
// key-valueテーブル。値はSETTINGS_ENCRYPTION_KEYで暗号化してから保存する(平文保存禁止)。
// DATABASE_URL/JWT_SECRETのような起動必須値はこの対象にせず引き続き.envで管理する。
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// 仕様書外の拡張: ログイン失敗回数制限(アカウント+IP単位、5回失敗で15分ロック)をDBで管理する。
// サーバーレス環境ではインスタンスが使い捨てのためインメモリ管理は機能しない。
// 存在しないメールアドレスへの試行も追跡する必要があるためusersとは別テーブルとする。
model LoginAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  email       String
  ip          String
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([email, ip], name: "email_ip")
  @@map("login_attempts")
}

// 残課題指示書Stage12: express-rate-limitの既定MemoryStoreはプロセスごとに独立しており、
// Vercelの複数サーバーレスインスタンス間で回数が共有されない(login_attemptsと同じ問題)。
// IP・対象識別子(メールアドレス・クーポンコード等)を組み合わせた汎用の固定ウィンドウ
// カウンタとしてDBに永続化することで、インスタンスをまたいでも同じキーなら同一の
// 回数として扱われるようにする。login_attemptsとは目的(アカウントロック vs 一般的な
// リクエスト頻度制限)が異なるため、あえて統合せず別テーブルとする。
model RateLimitBucket {
  bucketKey   String   @id @map("bucket_key")
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  // 本番安定化指示書Stage3(6.7「cleanup」): 古いbucket(updated_at基準)を定期削除するための索引。
  @@index([updatedAt])
  @@map("rate_limit_buckets")
}

// 仕様書外の拡張: 管理者・代理店ポータルによる状態変更操作(価格変更・報酬ステータス変更・
// 注文状態変更等)の監査ログ。誰が・いつ・どのAPIに対して・どんな内容で操作したかを記録する。
// usersへの物理FKは張らない(退会等でユーザーが削除されてもログ自体は残す)。
// Stripe/Resend等の秘密情報はミドルウェア側でマスクしてから記録し、平文保存しない。
model AdminAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  actorRole   String   @map("actor_role")
  method      String
  path        String
  requestBody Json?    @map("request_body")
  statusCode  Int      @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorUserId])
  @@map("admin_audit_logs")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  email          String   @unique
  phone          String?
  passwordHash   String   @map("password_hash")
  role           String   @default("user") // user | admin | admin_viewer(閲覧専用管理者。仕様書外の拡張) | staff(仕様書外の拡張) | agency
  agencyId       String?  @map("agency_id") @db.Uuid // role=agencyの場合のみ設定(仕様書外の拡張: 代理店ポータルログイン)
  // 仕様書外の拡張(残課題指示書Stage11): JWTの即時失効用。role・agencyId変更、パスワード変更、
  // アカウント停止、強制ログアウト時にインクリメントする。JWT発行時にスナップショットし、
  // requireAuthでDBの最新値と照合することで、旧Cookieを即座に無効化する。
  sessionVersion Int      @default(1) @map("session_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // 仕様書外の拡張: 初回購入時に紐づいた代理店への永久帰属(first-touch)。
  // 一度設定したら変更しない。以降の全ての注文はこの代理店/インフルエンサーに
  // 帰属し続ける(仕様書6.5同様、物理FKは張らない)。
  referredByAgencyId       String?   @map("referred_by_agency_id") @db.Uuid
  referredByInfluencerId   String?   @map("referred_by_influencer_id") @db.Uuid
  referredByReferralLinkId String?   @map("referred_by_referral_link_id") @db.Uuid
  referredByCode           String?   @map("referred_by_code")
  referredAt               DateTime? @map("referred_at")

  // 仕様書外の拡張: 会員が代理店(インフルエンサー)への昇格を申請した日時。
  // 外部代理店システム(sengoku-ai.com)へ候補として送信済み・承認待ちであることを示す。
  // 承認されるとroleがagencyに変わり、このフィールドはクリアされる。
  agencyApplicationSubmittedAt DateTime? @map("agency_application_submitted_at")

  // 仕様書外の拡張(千ノ国全体統合 共通実装契約 2026-07-21 4.1章): 代理店システムの共通顧客HUBが
  // 発行するcu_...形式の共通ユーザーID。このシステムが独自発番することはなく(3.2禁止事項)、
  // resolve API呼び出しが未実装の間は常にnull。
  commonUserId String? @unique @map("common_user_id")

  wallet                   Wallet?
  orders                   Order[]
  nftIssues                NftIssue[]
  passwordResetTokens      PasswordResetToken[]
  noticeReads              NoticeRead[]
  agency                   Agency?                   @relation(fields: [agencyId], references: [id])
  couponEntries            CouponCustomer[]
  walletVerificationNonces WalletVerificationNonce[]
  walletChangeLogs         WalletChangeLog[]
  walletReminderEmailsSent WalletReminderEmail[]
  externalIdentities       ExternalIdentity[]

  @@map("users")
}

// 仕様書外の拡張(千ノ国全体統合 共通実装契約 2026-07-21 5.1章): 各外部システムのユーザーIDと
// 代理店システムの共通ユーザーIDとの対応を保持する(system_account_links相当)。resolve API呼び出しが
// 未実装の間は空のまま。
model ExternalIdentity {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  systemKey      String    @default("sengoku-market") @map("system_key")
  externalUserId String    @map("external_user_id")
  commonUserId   String?   @map("common_user_id")
  identityType   String    @map("identity_type") // email | phone | line | wallet 等
  verifiedAt     DateTime? @map("verified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([systemKey, externalUserId])
  @@index([commonUserId])
  @@map("external_identities")
}

model Wallet {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  walletAddress      String    @map("wallet_address")
  chain              String    @default("polygon")
  // 仕様書外の拡張: ウォレット所有確認(署名検証)。verified=trueになって初めて
  // nft_issuesのwallet_required→ready_to_issue一括更新の対象になる。
  verified           Boolean   @default(false)
  verificationMethod String?   @map("verification_method") // personal_sign
  verifiedAt         DateTime? @map("verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("wallets")
}

// 仕様書外の拡張: ウォレット署名検証用の使い捨てnonce。password_reset_tokensと同型。
// 発行時のアドレスと署名時のアドレスが一致することも検証する(すり替え防止)。
model WalletVerificationNonce {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  walletAddress String    @map("wallet_address")
  nonce         String    @unique
  expiresAt     DateTime  @map("expires_at")
  usedAt        DateTime? @map("used_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("wallet_verification_nonces")
}

// 仕様書外の拡張: ウォレットアドレスの変更履歴。admin_audit_logsは管理者操作専用で
// before/after差分を持たないため、会員自身によるセルフサービス変更も含めて記録する
// 専用テーブルとして分離する。
model WalletChangeLog {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  previousAddress    String?  @map("previous_address")
  newAddress         String   @map("new_address")
  verificationMethod String   @map("verification_method")
  changedBy          String   @map("changed_by") // self | admin
  createdAt          DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("wallet_change_logs")
}

model Product {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  description      String?
  category         String
  itemType         String   @default("nft") @map("item_type") // nft | physical | service | membership | fee
  // 仕様書外の拡張(千ノ国5システム共通方針書v3.0 15章): 商品ごとの販売方式。
  // direct_allowed = 代理店なしで購入可, agent_required = 販売担当代理店が確定していないと
  // 購入不可, hybrid = 両方可(既存商品はすべてこれで初期化。紹介コードは従来通り任意入力)。
  salesModel       String   @default("hybrid") @map("sales_model")
  basePrice        Int      @map("base_price")
  status           String   @default("draft") // draft | published | archived
  // 仕様書外の拡張: 商品画像の複数枚対応。先頭(images[0])を一覧・OGP等のサムネイルとして扱う。
  images           String[] @default([])
  // 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)12章: 不変のシリアル番号を
  // 商品単位で発番するための原子カウンタ。UPDATE...RETURNING形式の行ロック更新でのみ
  // インクリメントする(並行購入でも重複しないようにするため。nft_issues.serial_numberの
  // 採番元であり、この値自体を直接表示・参照することはない)。
  nftSerialCounter Int      @default(0) @map("nft_serial_counter")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variants         ProductVariant[]
  orderItems       OrderItem[]
  nftIssues        NftIssue[]
  couponEntries    CouponProduct[]
  integrationRules ProductIntegrationRule[]

  @@map("products")
}

// 仕様書外の拡張(千ノ国全体統合 共通実装契約 2026-07-21 5.6章): 商品名の文字列判定ではなく、
// 商品ごとにentitlement(権利)の送信先・種別を設定できるようにするルーティング設定。
// 送信先の実エンドポイントが未確定のため、設定してもOutboxはpendingのまま留まり実送信はされない。
// 本番安定化指示書Stage6(9.1・9.2): 1商品につき1送信先だと、例えばAIアート教室の権利付与と
// OVEポイント付与を同時に行えない。productIdのunique制約を外し、1商品から複数のルール
// (送信先ごとに1行)を持てるようにする(1:N化)。
model ProductIntegrationRule {
  id                         String   @id @default(uuid()) @db.Uuid
  productId                  String   @map("product_id") @db.Uuid
  productCode                String?  @map("product_code")
  entitlementTargetSystemKey String?  @map("entitlement_target_system_key") // sengoku-passport | ove-wallet | ai-art-school
  entitlementType            String?  @map("entitlement_type")
  rewardRuleId               String?  @map("reward_rule_id")
  // 本番安定化指示書Stage6(9.3・9.4): OVE Wallet向けのポイント計算設定。商品の購入数量を
  // そのままポイント数として送らず、この設定に基づいて計算する。
  // rewardCalculationMode: fixed_per_order(注文単位で固定額) | per_quantity(数量に比例) |
  // fixed_total(常に固定額。fixed_per_orderと現状同じ扱いだが、将来の計算方式追加に備えて
  // 意味を分けておく)。
  rewardAmountPerUnit        Int?     @map("reward_amount_per_unit")
  rewardCalculationMode      String?  @map("reward_calculation_mode")
  revokeOnRefund             Boolean  @default(true) @map("revoke_on_refund")
  // 仕様書外の拡張(残課題指示書Stage6・8.3): 送信先ごとに必須とするIDを設定可能にする。
  // 既定値はすべてfalse(現状どおり未解決のnullがあっても送信する)であり、既存の挙動を変えない。
  requireCommonUserId        Boolean  @default(false) @map("require_common_user_id")
  requireSalesAgentId        Boolean  @default(false) @map("require_sales_agent_id")
  requireClosingAgentId      Boolean  @default(false) @map("require_closing_agent_id")
  requireReferralSessionKey  Boolean  @default(false) @map("require_referral_session_key")
  // 本番安定化指示書Stage6(9.5・9.7): 無効化したルールは送信対象から外す(行を削除せず
  // enabled=falseにするだけで一時停止できるようにする)。既定はtrue(既存の挙動を変えない)。
  enabled                    Boolean  @default(true)
  // 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)11・13章: entitlementType=
  // 'digital_collectible'の商品のみで使う、カード送付イベント用のメタデータ。他のentitlementType
  // (ove_reward等)では常にnull。assetCodeはproductCode(汎用の商品コード)とは別に、
  // カード種別を識別するための千ノ国ウォレット側のコード。
  assetCode                  String?  @map("asset_code")
  collectibleRarity          String?  @map("collectible_rarity")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, entitlementTargetSystemKey, entitlementType])
  @@map("product_integration_rules")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  name          String
  sku           String?  @unique
  price         Int
  stock         Int      @default(0)
  reservedStock Int      @default(0) @map("reserved_stock")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id])
  orderItems OrderItem[]
  nftIssues  NftIssue[]

  @@map("product_variants")
}

model Order {
  id                            String    @id @default(uuid()) @db.Uuid
  orderNumber                   String    @unique @map("order_number")
  userId                        String?   @map("user_id") @db.Uuid
  totalAmount                   Int       @map("total_amount")
  paymentStatus                 String    @default("pending") @map("payment_status") // pending | paid | failed | refunded | expired
  orderStatus                   String    @default("pending") @map("order_status") // pending | paid | cancelled | refunded
  // 仕様書外の拡張: 決済手段。bank_transferの場合、決済確定はStripe Webhookではなく
  // 管理画面からの手動確認(admin/orders.tsの入金確認)によって行われる。external_importは
  // このシステム以外の販路で決済済みの購入者を事後的に取り込んだ注文(admin/externalOrders.ts)。
  paymentMethod                 String    @default("stripe") @map("payment_method") // stripe | bank_transfer | external_import
  paidAt                        DateTime? @map("paid_at")
  refundedAt                    DateTime? @map("refunded_at")
  expiredAt                     DateTime? @map("expired_at")
  stripeSessionId               String?   @map("stripe_session_id")
  stripePaymentIntentId         String?   @map("stripe_payment_intent_id")
  referralCode                  String?   @map("referral_code")
  referrerName                  String?   @map("referrer_name")
  agencyName                    String?   @map("agency_name")
  // 以下3項目はreferral_links等への物理FKを張らない(仕様書6.5のDDL通り)
  agencyId                      String?   @map("agency_id") @db.Uuid
  influencerId                  String?   @map("influencer_id") @db.Uuid
  referralLinkId                String?   @map("referral_link_id") @db.Uuid
  commissionRate                Decimal   @default(0) @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount              Int       @default(0) @map("commission_amount")
  commissionStatus              String    @default("pending") @map("commission_status") // pending | approved | paid | cancelled
  customerName                  String    @map("customer_name")
  customerEmail                 String    @map("customer_email")
  customerPhone                 String?   @map("customer_phone")
  customerPostalCode            String?   @map("customer_postal_code")
  customerAddress               String?   @map("customer_address")
  termsAgreedAt                 DateTime  @map("terms_agreed_at")
  termsVersion                  String    @map("terms_version")
  adminNote                     String?   @map("admin_note")
  // 仕様書外の拡張: この注文でゲスト用アカウントを新規作成したかどうか。
  // 決済完了時にパスワード設定メールを送るべきか判定するために使う(仕様書v1.5 4.9)。
  guestAccountCreated           Boolean   @default(false) @map("guest_account_created")
  // 仕様書外の拡張(クーポン機能): totalAmountは既存通り「実際に決済する金額」のまま維持し、
  // originalAmountに割引前金額、couponDiscountAmountに割引額をスナップショットする。
  // クーポン未使用時もoriginalAmount=totalAmount・couponDiscountAmount=0として保存する。
  couponId                      String?   @map("coupon_id") @db.Uuid
  couponCode                    String?   @map("coupon_code")
  couponDiscountAmount          Int       @default(0) @map("coupon_discount_amount")
  originalAmount                Int       @map("original_amount")
  // 仕様書外の拡張: アドバイザー経由の注文で、上位(ディレクター・エージェント)への
  // 紐付けを記録のみ目的でスナップショットする(報酬計算には使わない)。
  // [{ id, name, code, depth }, ...] の配列。depth 0が直属、上位ほど大きい。
  referralHierarchy             Json?     @map("referral_hierarchy")
  // 仕様書外の拡張: 紹介コードの持ち主(referrerName)とは別に、購入者に商品を説明した
  // 担当者名を記録する。紹介コードと同様、注文時点の値として一度スナップショットしたら
  // 変更しない性質のものではなく、後から入力・修正されうるためadmin側からの更新も許可する
  // (referral_code等とは独立したフィールドであり、仕様書16章の「紹介コード変更禁止」には
  // 抵触しない)。名簿と一致すればID、しなければ名前のみ保存する(照合失敗で購入を止めない)。
  explainerName                 String?   @map("explainer_name")
  explainerAgencyId             String?   @map("explainer_agency_id") @db.Uuid
  explainerInfluencerId         String?   @map("explainer_influencer_id") @db.Uuid
  // 仕様書外の拡張(千ノ国全体統合 共通実装契約 2026-07-21 4.1/4.2/7章): 外部システム連携用の
  // 注文時スナップショット。既存のagencyId/influencerId(このDB内のUUID・報酬計算対象)とは別物で、
  // 代理店システムが発行する外部agent_code(文字列)をそのまま保持する。commonUserIdも代理店システムの
  // 共通顧客HUBが発行するcu_...形式のIDで、このシステムが独自発番することはない。
  // いずれも実際の外部呼び出し(common-users/resolve・referrals/capture・confirm)が未実装のため、
  // 現時点では常にnull/unresolvedのまま保存される(3.2禁止事項: 既存explainer_*をこれらへ自動転用しない)。
  commonUserId                  String?   @map("common_user_id")
  commonUserResolutionStatus    String    @default("unresolved") @map("common_user_resolution_status") // unresolved | resolved | skipped
  registrationReferrerAgentCode String?   @map("registration_referrer_agency_id")
  assignedAgentCode             String?   @map("assigned_agency_id")
  salesAgentCode                String?   @map("sales_agent_id")
  closingAgentCode              String?   @map("closing_agent_id")
  referralSessionKey            String?   @map("referral_session_key")
  correlationId                 String?   @map("correlation_id")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")

  user               User?                    @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]
  nftIssues          NftIssue[]
  commission         Commission?
  couponUsage        CouponUsage?
  walletTransactions OrderWalletTransaction[]
  walletClaim        WalletClaim?

  @@index([paymentStatus])
  @@index([paidAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  variantName String?  @map("variant_name")
  itemType    String   @map("item_type") // 注文時点のproducts.item_typeスナップショット
  quantity    Int
  unitPrice   Int      @map("unit_price")
  subtotal    Int
  createdAt   DateTime @default(now()) @map("created_at")

  order              Order                    @relation(fields: [orderId], references: [id])
  product            Product                  @relation(fields: [productId], references: [id])
  variant            ProductVariant?          @relation(fields: [variantId], references: [id])
  nftIssues          NftIssue[]
  walletTransactions OrderWalletTransaction[]

  @@map("order_items")
}

model NftIssue {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  orderItemId       String    @map("order_item_id") @db.Uuid
  userId            String?   @map("user_id") @db.Uuid
  productId         String    @map("product_id") @db.Uuid
  variantId         String?   @map("variant_id") @db.Uuid
  walletAddress     String?   @map("wallet_address")
  tokenId           String?   @map("token_id")
  transactionHash   String?   @map("transaction_hash")
  chain             String    @default("polygon")
  status            String    @default("wallet_required") // wallet_required | ready_to_issue | processing | issued | failed | cancelled
  issuedAt          DateTime? @map("issued_at")
  adminNote         String?   @map("admin_note")
  // 仕様書外の拡張: 外部Mint API連携(自動発行)用。cronがready_to_issueの行を
  // アトミックにprocessingへclaimしてから外部APIへ送信し、二重発行を防ぐ。
  providerRequestId String?   @map("provider_request_id") // 外部Mint APIのジョブ/リクエストID
  metadataUri       String?   @map("metadata_uri") // Vercel Blobに置いたmetadata JSONのURL
  submittedAt       DateTime? @map("submitted_at")
  attemptCount      Int       @default(0) @map("attempt_count")
  lastError         String?   @map("last_error")
  // このタイムスタンプが未来の間はcronの再試行対象から除外する(指数バックオフ/保留の実現)。
  nextAttemptAt     DateTime? @map("next_attempt_at")
  // 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)12章: マーケット側で発番する
  // 不変のシリアル番号。digital_collectible対象の行のみ、WalletClaim作成と同一トランザクションで
  // Product.nftSerialCounterから採番する(付与後は変更しない)。他の(既存の)NFT商品の行は
  // 引き続きnullのまま(nftMintProcessing.tsが従来通りベストエフォートで別途採番する)。
  serialNumber      Int?      @map("serial_number")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  order     Order           @relation(fields: [orderId], references: [id])
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id])
  user      User?           @relation(fields: [userId], references: [id])
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  walletReminderEmails WalletReminderEmail[]
  collectibleDelivery  CollectibleDelivery?
  walletClaimItem      WalletClaimItem?

  @@unique([productId, serialNumber])
  @@index([status])
  @@map("nft_issues")
}

// 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)4章: NFT対象商品(digital_collectible)の
// 購入後、決済確定と同一トランザクションで作成する注文単位のClaim。千ノ国ウォレット側でこのトークンを
// 使ってログイン・本人確認したうえで、実際のカード送付(CollectibleDelivery)へ進む。
model WalletClaim {
  id                     String    @id @default(uuid()) @db.Uuid
  orderId                String    @unique @map("order_id") @db.Uuid
  // 生トークンはURLにのみ含め、DBにはSHA-256ハッシュだけを保存する(仕様書16章「Token平文保存禁止」)。
  tokenHash              String    @unique @map("token_hash")
  // Wallet Claim本番前安定化指示書(2026-07-25)Phase6: PENDING|CLAIMED|DELIVERY_PENDING|DELIVERED|
  // REVOCATION_PENDING(取消送信中)|REVOKED|MANUAL_REVIEW_REQUIRED(Mint後返金・要手動確認)|
  // EXPIRED|ERROR
  status                 String    @default("PENDING")
  expiresAt              DateTime  @map("expires_at")
  claimedAt              DateTime? @map("claimed_at")
  // Phase7: 各状態遷移完了時刻をclaimed_atとは独立して記録する(claimed_atは上書きしない)。
  deliveredAt            DateTime? @map("delivered_at")
  revokedAt              DateTime? @map("revoked_at")
  manualReviewRequiredAt DateTime? @map("manual_review_required_at")
  // Claim確認API(POST .../confirm)のリクエストで千ノ国ウォレットから渡された値をスナップショットする。
  commonUserId           String?   @map("common_user_id")
  oveAccountId           String?   @map("ove_account_id")
  lastError              String?   @map("last_error")
  // Phase1: 再発行の同時実行制御(CAS)・監査用。実際の排他制御はtoken_hashの一致条件による
  // 楽観ロックで行うため、token_versionはCAS判定に使うのではなく監査・表示用の値として持たせる。
  tokenVersion           Int       @default(0) @map("token_version")
  lastReissuedAt         DateTime? @map("last_reissued_at")
  reissueCount           Int       @default(0) @map("reissue_count")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  order      Order                 @relation(fields: [orderId], references: [id])
  items      WalletClaimItem[]
  deliveries CollectibleDelivery[]
  auditLogs  WalletClaimAuditLog[]

  @@map("wallet_claims")
}

// Wallet Claim本番前安定化指示書(2026-07-25)Phase4: 決済確定時点の対象NftIssue・連携ルール・
// カード情報のスナップショット。Confirm時はProductIntegrationRuleを再取得せず、この行を基準に
// CollectibleDelivery・Outboxを作成する(購入後のルール変更・無効化で配送対象が変わらないようにする)。
model WalletClaimItem {
  id                       String   @id @default(uuid()) @db.Uuid
  walletClaimId            String   @map("wallet_claim_id") @db.Uuid
  nftIssueId               String   @unique @map("nft_issue_id") @db.Uuid
  orderItemId              String   @map("order_item_id") @db.Uuid
  productId                String   @map("product_id") @db.Uuid
  productIntegrationRuleId String   @map("product_integration_rule_id") @db.Uuid
  destinationSystemKey     String   @map("destination_system_key")
  entitlementType          String   @map("entitlement_type")
  // 千ノ国全体統合契約のentitlement系イベントpayloadに含まれるproduct_code(汎用の商品コード)を
  // 決済時点でスナップショットする。ルール削除・変更後もOutbox payloadの構造を維持するため。
  productCode              String?  @map("product_code")
  assetCode                String?  @map("asset_code")
  serialNumber             Int?     @map("serial_number")
  name                     String
  description              String?
  imageUrl                 String?  @map("image_url")
  thumbnailUrl             String?  @map("thumbnail_url")
  imageHash                String?  @map("image_hash")
  rarity                   String?
  // PENDING(未送付)|DELIVERED|REVOKED。CollectibleDelivery作成前の対象確定用フラグであり、
  // 実際の送付状況の正はCollectibleDeliveryが持つ(この列は「返金でこの明細をもう対象にしない」
  // 用途のみに使う)。
  status                   String   @default("PENDING")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  walletClaim WalletClaim @relation(fields: [walletClaimId], references: [id])
  nftIssue    NftIssue    @relation(fields: [nftIssueId], references: [id])

  @@index([walletClaimId])
  @@map("wallet_claim_items")
}

// 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)5章: NftIssue単位(1枚=1件)の
// カード送付状況。WalletClaimはorder単位・こちらはNftIssue単位という粒度の違いに対応する。
model CollectibleDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  walletClaimId String    @map("wallet_claim_id") @db.Uuid
  nftIssueId    String    @unique @map("nft_issue_id") @db.Uuid
  // entitlement_id = NftIssue.id(仕様書5章)。NftIssue単位Outboxのpayload・
  // 千ノ国ウォレット側の突合キーとして文字列のまま独立保持する。
  entitlementId String    @unique @map("entitlement_id")
  commonUserId  String    @map("common_user_id")
  oveAccountId  String    @map("ove_account_id")
  status        String    @default("PENDING") // PENDING|PROCESSING|DELIVERED|REVOKED|FAILED|DEAD
  deliveredAt   DateTime? @map("delivered_at")
  revokedAt     DateTime? @map("revoked_at")
  lastError     String?   @map("last_error")
  outboxEventId String?   @map("outbox_event_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  walletClaim WalletClaim             @relation(fields: [walletClaimId], references: [id])
  nftIssue    NftIssue                @relation(fields: [nftIssueId], references: [id])
  outboxEvent IntegrationOutboxEvent? @relation(fields: [outboxEventId], references: [id])

  @@index([status])
  @@map("collectible_deliveries")
}

// 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)9章: common_user_id本人確認の
// 不一致・未解決等、セキュリティ上追跡すべきClaim確認APIの判定結果を記録する監査ログ。
// admin_audit_logsは管理者(社内)の操作専用で、外部(千ノ国ウォレット)からのサーバー間呼び出し
// には使えないため専用テーブルとして分離する。
model WalletClaimAuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  walletClaimId String?  @map("wallet_claim_id") @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  eventType     String   @map("event_type") // common_user_mismatch | common_user_unresolved | claim_confirmed | claim_reissued | claim_revoked 等
  detail        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  walletClaim WalletClaim? @relation(fields: [walletClaimId], references: [id])

  @@index([walletClaimId])
  @@index([createdAt])
  @@map("wallet_claim_audit_logs")
}

// 戦国マーケット NFTカード受取・送付 実装指示書(2026-07-25)8章: Claim確認APIのHMAC認証で
// 使うnonceのリプレイ防止用記録。wallet_verification_noncesは会員自身のpersonal_sign用で
// 用途が異なるため分離する(このテーブルは千ノ国ウォレット側が生成したnonceを記録するのみで、
// このシステムからnonceを発行することはない)。
model WalletClaimApiNonce {
  id        String   @id @default(uuid()) @db.Uuid
  nonce     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  // Wallet Claim本番前安定化指示書(2026-07-25)Phase2: 古いnonceを定期削除するcronで使う。
  @@index([createdAt])
  @@map("wallet_claim_api_nonces")
}

// 仕様書外の拡張: ウォレット未登録者一覧(admin/wallet-missing)から購入者へ送った登録案内
// メールの送信記録。仕様書5.5の任意実装「最終案内メール送信日時」に対応する。
// ウォレットアドレス自体の登録・変更は署名検証(personal_sign)が必須のままであり、
// この記録はあくまで案内メールの送信履歴であって、ウォレットの登録・確認状態には影響しない。
model WalletReminderEmail {
  id         String   @id @default(uuid()) @db.Uuid
  nftIssueId String   @map("nft_issue_id") @db.Uuid
  sentBy     String   @map("sent_by") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at")

  nftIssue   NftIssue @relation(fields: [nftIssueId], references: [id])
  sentByUser User     @relation(fields: [sentBy], references: [id])

  @@index([nftIssueId])
  @@map("wallet_reminder_emails")
}

// 仕様書外の拡張(千ノ国全体統合 共通実装契約 2026-07-21 6章): 決済確定・返金等のイベントを
// 下流システム(代理店システム・パスポート・ウォレット・AIアート教室)へ送信するためのOutbox。
// 決済確定と同一トランザクションでenqueueすることで、下流が停止していても決済の事実(paid)を
// 失わない。宛先の実エンドポイント・認証情報が未設定の間、ディスパッチャは何も送信せず
// pendingのまま保持する(安全側のデフォルト)。
model IntegrationOutboxEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  eventId              String    @unique @map("event_id") // evt_... 形式。送信元(このシステム)で一意に固定
  eventType            String    @map("event_type") // order.paid 等(契約書6.2章)
  eventVersion         String    @default("1.0") @map("event_version")
  destinationSystemKey String    @map("destination_system_key") // agency-system | sengoku-passport | ove-wallet | ai-art-school
  // 本番安定化指示書Stage7(10.1・10.2): 送信直前の再取得(reconcileEntitlementFields)で
  // payloadが最新値へ更新されるが、以前は同じpayload列を上書きしていたためenqueue時点の
  // 監査用データが失われ、かつpayload_hashが古いままという不整合があった。
  // originalPayload(enqueue時点、以後不変)とdeliveryPayload(実際に送信を試みる値。
  // 再取得のたびに更新)を分離し、それぞれ専用のhashを持たせる。
  originalPayload      Json      @map("original_payload")
  originalPayloadHash  String    @map("original_payload_hash")
  deliveryPayload      Json      @map("payload")
  deliveryPayloadHash  String    @map("payload_hash")
  correlationId        String?   @map("correlation_id")
  status               String    @default("pending") @map("status") // pending | processing | succeeded | failed | dead | blocked
  attemptCount         Int       @default(0) @map("attempt_count")
  lastError            String?   @map("last_error")
  // 仕様書外の拡張(残課題指示書Stage6): 必須ID(product_integration_rulesで設定)が未解決のため
  // 送信を保留した理由(例: common_user_unresolved)。status='blocked'の間のみ設定される。
  blockedReason        String?   @map("blocked_reason")
  // 仕様書外の拡張(残課題指示書Stage7): claim所有権をprocessing_tokenで明示化する
  // (Stripe Event Inbox・notification_outbox_events・order_linking_jobsと同じ設計)。
  // success/failure更新もこのtokenの一致を条件にすることで、staleなprocessing回収と
  // 実際の送信完了が競合しても、古い方が新しい結果を上書きしない。
  processingToken      String?   @map("processing_token")
  processingStartedAt  DateTime? @map("processing_started_at")
  nextAttemptAt        DateTime? @map("next_attempt_at")
  processedAt          DateTime? @map("processed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  // 仕様書外の拡張(2026-07-22千ノ国全体連携パッケージ対応): dispatcherがstaleなprocessing行
  // (クラッシュ等で放置された行)を検知するために使う。NFT自動発行の既存のstale検知パターンを踏襲。
  updatedAt            DateTime  @updatedAt @map("updated_at")

  attempts              IntegrationEventAttempt[]
  walletTransactions    OrderWalletTransaction[]
  collectibleDeliveries CollectibleDelivery[]

  @@index([status])
  @@index([destinationSystemKey])
  @@map("integration_outbox_events")
}

// 仕様書外の拡張(残課題指示書Stage7・9.2「試行履歴」): 送信の実施記録。1回の送信試行
// (成功・失敗いずれも)につき1行作成する。blocked(送信を試みずに保留した回)は「試行」では
// ないためここには記録しない。
model IntegrationEventAttempt {
  id                  String    @id @default(uuid()) @db.Uuid
  outboxEventId       String    @map("outbox_event_id") @db.Uuid
  attemptNumber       Int       @map("attempt_number")
  startedAt           DateTime  @map("started_at")
  finishedAt          DateTime? @map("finished_at")
  httpStatus          Int?      @map("http_status")
  result              String // succeeded | failed
  error               String?
  processingToken     String?   @map("processing_token")
  // 本番安定化指示書Stage7(10.3「試行履歴」): この試行で実際に送信したdelivery_payloadの
  // hash(payload差分の追跡用)・送信先URL・応答本文の抜粋(秘密情報は含めない・長さ制限)。
  requestPayloadHash  String?   @map("request_payload_hash")
  destinationUrl      String?   @map("destination_url")
  responseBodyExcerpt String?   @map("response_body_excerpt")
  createdAt           DateTime  @default(now()) @map("created_at")

  outboxEvent IntegrationOutboxEvent @relation(fields: [outboxEventId], references: [id])

  @@index([outboxEventId])
  @@map("integration_event_attempts")
}

// 本番安定化指示書Stage10(13.1〜13.4): OVE Walletへのreward付与・取消(REVERSAL)のtransaction IDを
// これまでintegration_outbox_events.payload(ove_transaction_id)へ暫定的に保存していたが、
// 専用テーブルへ切り出す。取消(reversal)時にorder_item_idだけでOutboxを検索すると、1商品に
// 複数のOVE向けルール(entitlement_typeが異なる等)がある場合に原付与を誤って特定しうるため、
// productIntegrationRuleIdも保持して一意に特定する。1行 = 1回のgrant成功 または 1回のreversal成功
// (dry_run・失敗した試行はここに書かない。試行そのものの記録はintegration_event_attemptsが担う)。
model OrderWalletTransaction {
  id                          String   @id @default(uuid()) @db.Uuid
  orderId                     String   @map("order_id") @db.Uuid
  orderItemId                 String   @map("order_item_id") @db.Uuid
  outboxEventId               String   @map("outbox_event_id") @db.Uuid
  // 同一order_item_idに複数のOVE向けルールが設定されている場合の原付与特定に使う。
  productIntegrationRuleId    String?  @map("product_integration_rule_id") @db.Uuid
  commonUserId                String?  @map("common_user_id")
  transactionType             String   @map("transaction_type") // grant | reversal
  amount                      Int
  rewardRuleId                String?  @map("reward_rule_id")
  // transactionType=grant: OVE Wallet側が発行したtransaction_id。
  // transactionType=reversal: OVE Wallet側のreversal API呼び出し自体は別IDを返さないため通常null。
  walletTransactionId         String?  @map("wallet_transaction_id")
  // transactionType=reversalの行にのみ設定。取消対象となった原付与行のwalletTransactionId。
  originalWalletTransactionId String?  @map("original_wallet_transaction_id")
  // 冪等キー。原則としてこの行の元になったintegration_outbox_events.event_idをそのまま使う
  // (1 outbox event成功につき1行のみ作成されることをDB制約でも保証する)。
  idempotencyKey              String   @unique @map("idempotency_key")
  status                      String   @default("succeeded") // succeeded(現状これのみ書き込まれる)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  order       Order                  @relation(fields: [orderId], references: [id])
  orderItem   OrderItem              @relation(fields: [orderItemId], references: [id])
  outboxEvent IntegrationOutboxEvent @relation(fields: [outboxEventId], references: [id])

  @@index([orderItemId, transactionType])
  @@index([originalWalletTransactionId])
  @@map("order_wallet_transactions")
}

// 仕様書外の拡張(残課題指示書Stage4): checkout.tsが行っていたfire-and-forget(`void
// runBestEffortSennokuniOrderLinking(...)`・`void bestEffortResolveAndLinkCommonUserId(...)`)は
// Serverlessではレスポンス完了後の処理完了が保証されないため、common_user_id解決・referral
// captureを注文作成(・会員登録)と同一トランザクションでこのテーブルへ記録する永続ジョブ化する。
// referral confirm(event=registration/purchase)は残課題指示書Stage5で別途追加する。
model OrderLinkingJob {
  id                  String    @id @default(uuid()) @db.Uuid
  jobType             String    @map("job_type") // common_user_resolve | referral_capture | referral_confirm_purchase
  userId              String?   @map("user_id") @db.Uuid
  orderId             String?   @map("order_id") @db.Uuid
  // 本番安定化指示書Stage5(8.1): 同一user/orderに対する重複enqueueを防ぐ。
  // 例: common-user-resolve:<user_id> / referral-capture:<order_id> /
  // referral-confirm-purchase:<order_id>。enqueue側はcreateではなくupsert(重複時no-op)で使う。
  deduplicationKey    String?   @unique @map("deduplication_key")
  status              String    @default("pending") // pending | processing | blocked | succeeded | failed | dead | skipped
  attemptCount        Int       @default(0) @map("attempt_count")
  processingToken     String?   @map("processing_token")
  processingStartedAt DateTime? @map("processing_started_at")
  nextAttemptAt       DateTime? @map("next_attempt_at")
  lastError           String?   @map("last_error")
  // 本番安定化指示書Stage5(8.3): 依存先ジョブの完了待ちでblockedになった理由
  // (common_user_unresolved | referral_session_unresolved)。blockedはattempt_countを
  // 増やさない(依存待ちだけで再試行上限を消費してdeadにならないようにするため)。
  blockedReason       String?   @map("blocked_reason")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("order_linking_jobs")
}

// 仕様書外の拡張(残課題指示書Stage3): 代理店アカウント作成等に伴う通知メールを、
// 代理店・ログインユーザー作成と同一トランザクションでこのテーブルへ記録する。実際のメール送信は
// commit後にDispatcherが行うため、Resend未設定・送信失敗時でも代理店作成自体は成功し、
// 復旧後に再送できる(integration_outbox_eventsと異なりprocessing_token/processing_started_atを
// 最初から持たせ、Dispatcherの所有権管理を明確にする)。
model NotificationOutboxEvent {
  id                   String    @id @default(uuid()) @db.Uuid
  eventType            String    @map("event_type") // agency_account_setup | agency_access_granted | wallet_claim_reissued
  recipient            String
  payload              Json
  status               String    @default("pending") // pending | processing | succeeded | failed | dead
  attemptCount         Int       @default(0) @map("attempt_count")
  processingToken      String?   @map("processing_token")
  processingStartedAt  DateTime? @map("processing_started_at")
  nextAttemptAt        DateTime? @map("next_attempt_at")
  lastError            String?   @map("last_error")
  // setup系通知でDispatcherが発行したパスワード設定トークンの参照(生トークンは保存しない)。
  // 再試行時にこのトークンを無効化してから新規発行することで、無制限に有効トークンが
  // 増えるのを防ぐ(残課題指示書5.5)。
  passwordResetTokenId String?   @map("password_reset_token_id") @db.Uuid
  processedAt          DateTime? @map("processed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("notification_outbox_events")
}

model Notice {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  body        String
  status      String    @default("draft") // draft | published
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  noticeReads NoticeRead[]

  @@map("notices")
}

// 仕様書外の拡張: お知らせの既読管理(会員単位)。お知らせが削除された場合は既読情報も不要になるため連動削除する。
model NoticeRead {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  noticeId String   @map("notice_id") @db.Uuid
  readAt   DateTime @default(now()) @map("read_at")

  user   User   @relation(fields: [userId], references: [id])
  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@unique([userId, noticeId])
  @@map("notice_reads")
}

// 仕様書外の拡張: 特商法・利用規約等の法務ページを管理画面から編集できるようにする。
// bodyは簡易記法のプレーンテキスト(## 見出し / ! 注意書き / key|value でテーブル行)。
model LegalDocument {
  slug      String   @id // tokushoho | terms | refund | privacy
  title     String
  body      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_documents")
}

// 仕様書外の拡張(千ノ国全体統合 共通実装契約 2026-07-21 5.4章): Stripe Webhookの冪等性をInbox方式に
// する。以前はevent_idをINSERTした時点でprocessedAtを確定していたため、その後の業務処理(注文確定等)が
// 失敗しても「重複」として扱われ、Stripeの再送では二度と処理されない欠陥があった。
// status(processing→succeeded/failed_retryable/failed_terminal)で実際の処理完了を追跡し、
// 失敗時は再送で再処理できるようにする。
model StripeEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  stripeEventId       String    @unique @map("stripe_event_id")
  eventType           String    @map("event_type")
  payloadHash         String    @map("payload_hash")
  status              String    @default("processing") @map("status") // processing | succeeded | failed_retryable | failed_terminal
  attemptCount        Int       @default(1) @map("attempt_count")
  lastError           String?   @map("last_error")
  processingStartedAt DateTime? @map("processing_started_at")
  // 処理の所有権トークン(仕様書外の拡張・2026-07-22指示書Stage1): staleなprocessing行を
  // 複数リクエストが同時に再クレームしても1件しか処理権を取得できないようCASの鍵として使う。
  processingToken     String?   @map("processing_token")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("stripe_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

model Agency {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  code                    String   @unique
  externalId              String?  @unique @map("external_id") // 外部の代理店システム側のID(仕様書外の拡張: API連携用)
  parentAgencyId          String?  @map("parent_agency_id") @db.Uuid // 親代理店(多階層ツリー構造。仕様書外の拡張)
  // 仕様書外の拡張(先方仕様書v3.6.40): 連携APIで親がまだ登録されていない代理店を受信した場合、
  // エラーにせずexternal_id文字列のまま保持しておき、親が後から届いた時点で自動的に再紐付けする。
  pendingParentExternalId String?  @map("pending_parent_external_id")
  contactName             String?  @map("contact_name")
  contactEmail            String?  @map("contact_email")
  status                  String   @default("active") // active | inactive
  defaultCommissionRate   Decimal  @default(0) @map("default_commission_rate") @db.Decimal(5, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  parentAgency  Agency?        @relation("AgencyHierarchy", fields: [parentAgencyId], references: [id])
  childAgencies Agency[]       @relation("AgencyHierarchy")
  loginUsers    User[]
  influencers   Influencer[]
  referralLinks ReferralLink[]
  commissions   Commission[]
  couponEntries CouponAgency[]

  @@map("agencies")
}

// 仕様書外の拡張(先方仕様書v3.6.45): 代理店システムからのSSOログインで使用したJWTの
// jtiを記録し、同一トークンの再利用(リプレイ)を拒否するための台帳。
model SsoUsedJti {
  id        String   @id @default(uuid()) @db.Uuid
  jti       String   @unique
  sub       String
  aud       String
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime @default(now()) @map("used_at")

  @@index([expiresAt])
  @@map("sso_used_jti")
}

model Influencer {
  id                    String   @id @default(uuid()) @db.Uuid
  agencyId              String?  @map("agency_id") @db.Uuid
  name                  String
  code                  String   @unique
  email                 String?
  snsUrl                String?  @map("sns_url")
  status                String   @default("active") // active | inactive
  defaultCommissionRate Decimal? @map("default_commission_rate") @db.Decimal(5, 2)
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  agency        Agency?        @relation(fields: [agencyId], references: [id])
  referralLinks ReferralLink[]
  commissions   Commission[]

  @@map("influencers")
}

model ReferralLink {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  agencyId        String?  @map("agency_id") @db.Uuid
  influencerId    String?  @map("influencer_id") @db.Uuid
  commissionRate  Decimal? @map("commission_rate") @db.Decimal(5, 2)
  landingPath     String   @default("/") @map("landing_path")
  status          String   @default("active") // active | inactive
  // 仕様書外の拡張(クーポン機能): 紹介リンクの編集・削除機能は作らない方針(CLAUDE.md)のため、
  // クーポンの設定は発行時のみ可能とする(後から付け替える専用APIは用意しない)。
  couponId        String?  @map("coupon_id") @db.Uuid
  couponAutoApply Boolean  @default(true) @map("coupon_auto_apply")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agency     Agency?     @relation(fields: [agencyId], references: [id])
  influencer Influencer? @relation(fields: [influencerId], references: [id])
  coupon     Coupon?     @relation(fields: [couponId], references: [id])

  // agency_id / influencer_id 両方NULLは不可(アプリ側バリデーションで担保。仕様書6.13参照)
  @@map("referral_links")
}

model Commission {
  id               String    @id @default(uuid()) @db.Uuid
  orderId          String    @unique @map("order_id") @db.Uuid
  agencyId         String?   @map("agency_id") @db.Uuid
  influencerId     String?   @map("influencer_id") @db.Uuid
  referralCode     String?   @map("referral_code")
  baseAmount       Int       @map("base_amount")
  commissionRate   Decimal   @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Int       @map("commission_amount")
  status           String    @default("pending") // pending | approved | paid | cancelled
  approvedAt       DateTime? @map("approved_at")
  paidAt           DateTime? @map("paid_at")
  adminNote        String?   @map("admin_note")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  order      Order       @relation(fields: [orderId], references: [id])
  agency     Agency?     @relation(fields: [agencyId], references: [id])
  influencer Influencer? @relation(fields: [influencerId], references: [id])

  @@index([status])
  @@map("commissions")
}

// 仕様書外の拡張: クーポン機能(sengoku_nft_cart_coupon_implementation_spec)。
// 既存の紹介・報酬・注文フローとは独立した追加機能として実装する。
model Coupon {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  name        String
  description String?

  discountType          String   @map("discount_type") // fixed | percentage
  // 金額はINTEGER(円)。discountTypeがfixedの時のみ使用(CLAUDE.md: 浮動小数点で金額計算しない)。
  discountAmount        Int?     @map("discount_amount")
  // 割合はDecimal(既存のcommissionRate等と同じ扱い)。discountTypeがpercentageの時のみ使用。
  discountPercentage    Decimal? @map("discount_percentage") @db.Decimal(5, 2)
  maximumDiscountAmount Int?     @map("maximum_discount_amount")
  minimumOrderAmount    Int?     @map("minimum_order_amount")

  startsAt  DateTime? @map("starts_at")
  expiresAt DateTime? @map("expires_at")

  totalUsageLimit       Int? @map("total_usage_limit")
  perCustomerUsageLimit Int  @default(1) @map("per_customer_usage_limit")
  usedCount             Int  @default(0) @map("used_count")
  // 在庫のreservedStockと同じ考え方: 決済完了前の予約分を別カウントし、
  // 総利用回数の上限を同時実行下でも超過させない。
  reservedCount         Int  @default(0) @map("reserved_count")

  // all | include | exclude (coupon_productsで対象/除外商品を指定)
  productScopeType  String @default("all") @map("product_scope_type")
  // all | include (coupon_agenciesで対象代理店を指定)
  agencyScopeType   String @default("all") @map("agency_scope_type")
  // all | include | new_customer (coupon_customersで対象顧客を指定)。
  // event_participant / gacha_result は将来のガチャシステム連携用に予約した値(今回は未実装)。
  customerScopeType String @default("all") @map("customer_scope_type")

  stackable       Boolean @default(false)
  isActive        Boolean @default(true) @map("is_active")
  restoreOnCancel Boolean @default(true) @map("restore_on_cancel")

  createdByAdminId String?   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  products      CouponProduct[]
  agencies      CouponAgency[]
  customers     CouponCustomer[]
  usages        CouponUsage[]
  referralLinks ReferralLink[]

  @@map("coupons")
}

model CouponProduct {
  id           String   @id @default(uuid()) @db.Uuid
  couponId     String   @map("coupon_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  relationType String   @default("include") @map("relation_type") // include | exclude
  createdAt    DateTime @default(now()) @map("created_at")

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([couponId, productId])
  @@map("coupon_products")
}

model CouponAgency {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  agencyId  String   @map("agency_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])

  @@unique([couponId, agencyId])
  @@map("coupon_agencies")
}

model CouponCustomer {
  id        String   @id @default(uuid()) @db.Uuid
  couponId  String   @map("coupon_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([couponId, userId])
  @@map("coupon_customers")
}

model CouponUsage {
  id       String  @id @default(uuid()) @db.Uuid
  couponId String  @map("coupon_id") @db.Uuid
  userId   String? @map("user_id") @db.Uuid
  agencyId String? @map("agency_id") @db.Uuid
  orderId  String? @unique @map("order_id") @db.Uuid

  originalAmount Int @map("original_amount")
  discountAmount Int @map("discount_amount")
  finalAmount    Int @map("final_amount")

  status      String    @default("reserved") // reserved | used | cancelled | expired
  reservedAt  DateTime? @map("reserved_at")
  usedAt      DateTime? @map("used_at")
  cancelledAt DateTime? @map("cancelled_at")
  expiresAt   DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([status])
  @@map("coupon_usages")
}

DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
APP_URL=
ADMIN_EMAIL=
ADMIN_PASSWORD=
TERMS_VERSION=2026-07-01
PORT=4000
# Stripe/Resendのキーは管理画面(DB, settingsテーブル)で管理する(仕様書外の拡張)。
# 保存値の暗号化に使う32byteのランダム値をhexで指定する(例: `openssl rand -hex 32`)。
SETTINGS_ENCRYPTION_KEY=
# 仕様書外の拡張: 管理画面の商品画像アップロード(Vercel Blob)用トークン。
# Vercelダッシュボードの Storage > Blob で有効化すると発行される。
# 本番(Vercel実行環境)では自動で環境変数に注入されるため、通常はローカル開発時のみ設定すればよい。
BLOB_READ_WRITE_TOKEN=
# 仕様書外の拡張: /api/internal/cron/* を保護する共有シークレット。Vercel Cron設定の
# Authorizationヘッダに同じ値を設定する(openssl rand -hex 32等で生成)。
CRON_SECRET=
# 仕様書外の拡張(NFT自動発行): Mintプロバイダーの切り替え(fake=ローカル開発・テスト用、
# crossmint=本番想定の外部Mint API)。APIキー自体は秘密情報のため管理画面(settingsテーブル)で
# nft_mint_api_keyとして管理する(ここには書かない)。
NFT_MINT_PROVIDER=fake
NFT_CHAIN=bsc
NFT_CHAIN_ID=56
NFT_EXPLORER_BASE_URL=https://bscscan.com/tx/
# 仕様書外の拡張(NFT自動発行): NFT_MINT_PROVIDER=crossmintの場合のみ使用。
# CrossmintコンソールでBinance Smart Chain向けに作成したコレクションのID(UUID)。
CROSSMINT_COLLECTION_ID=
# 仕様書外の拡張(千ノ国全体連携 共通インターフェース契約v1.1 DRAFT・2026-07-22指示書対応):
# common_user_id resolve・referral capture/confirm・Outbox実送信(ウォレットreward連携含む)の
# 有効/無効を切り替えるFeature Flag。共通契約は署名テストベクトル・event version未確定のDRAFTのため、
# 統合責任者が正式に承認するまでfalseのままにすること(true以外は常に無効)。
# 接続先URL・HMAC鍵等の認証情報は秘密情報のため管理画面(settingsテーブル)で管理する
# (sennokuni_hmac_key_id / sennokuni_hmac_secret / sennokuni_agency_hub_base_url /
#  integration_endpoint_sengoku_passport / integration_endpoint_ai_art_school /
#  integration_endpoint_path_sengoku_passport / integration_endpoint_path_ai_art_school /
#  ove_wallet_base_url / ove_wallet_api_key_id / ove_wallet_hmac_secret)。
SENNOKUNI_INTEGRATION_ENABLED=false
# 仕様書外の拡張(残課題指示書Stage7): integration_outbox_eventsディスパッチャが1回の実行で
# 新規claimを続けてよい時間の上限(ミリ秒)。VercelのFunction実行時間制限(プランにより異なる)に
# 合わせて調整する。未設定時は保守的な既定値(8000ms)を使う。
# INTEGRATION_OUTBOX_TIME_BUDGET_MS=8000

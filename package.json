{
  "name": "sengoku-nft-cart",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "client",
    "packages/contracts"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build:contracts": "npm run build --workspace=@sengoku/contracts",
    "build:server": "npm run build:contracts && npm run build --workspace=server",
    "build:client": "npm run build:contracts && npm run build --workspace=client",
    "typecheck:api": "tsc --noEmit -p tsconfig.json"
  }
}
